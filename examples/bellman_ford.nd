let inf = 1000000
let min a b = if a < b then a else b

let rec at l i =
  match l with
  [] -> inf
  | x :: r -> if i = 0 then x else at r (i - 1)

let rec best dist v edges =
  match edges with
  [] -> inf
  | e :: rest ->
      (match e with
      (a, b, w) ->
        if b = v && at dist a < inf then min (at dist a + w) (best dist v rest)
        else best dist v rest)

let relax n edges dist = [min (at dist v) (best dist v edges) | v <- [0..n - 1]]

let rec rounds k n edges dist =
  if k = 0 then dist else rounds (k - 1) n edges (relax n edges dist)

let edges =
  [(0, 1, 6); (0, 2, 7); (1, 2, 8); (1, 3, 5); (1, 4, -4);
   (2, 3, -3); (2, 4, 9); (3, 1, -2); (4, 0, 2); (4, 3, 7)]

let result = rounds 4 5 edges [if v = 0 then 0 else inf | v <- [0..4]]
