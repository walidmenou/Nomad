let min a b = if a < b then a else b

let edit xs ys =
  let x = from_list xs in
  let y = from_list ys in
  let d = grid (size x + 1) (size y + 1) 0 in
  [d[i][j] :=
     if i = 0 then j
     else if j = 0 then i
     else if x[i - 1] = y[j - 1] then d[i - 1][j - 1]
     else 1 + min d[i - 1][j - 1] (min d[i - 1][j] d[i][j - 1])
   | i <- [0..size x], j <- [0..size y]][size x][size y]

let result = [edit a b | (a, b) <- [([1; 2; 3], [1; 3]);
                                    ([1; 2; 3; 4], [2; 3; 4; 5]);
                                    ([1; 2; 3], [1; 2; 3]);
                                    ([], [1; 2])]]
