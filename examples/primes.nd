-- Primes up to n by trial division.
-- The guard rejects any x that some smaller number divides.

let not b = if b then false else true

let rec any p l =
  match l with
  [] -> false
  | x :: xs -> p x || any p xs

let primes n = [x | x <- [2..n], not (any (fun d -> x % d = 0) [2..x - 1])]

let result = primes 30
