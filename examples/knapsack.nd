let max a b = if a > b then a else b

let rec at l i =
  match l with
  [] -> 0
  | x :: r -> if i = 0 then x else at r (i - 1)

let take cap row item =
  match item with
  (wt, vl) ->
    [if w < wt then at row w else max (at row w) (at row (w - wt) + vl)
     | w <- [0..cap]]

let rec fill cap row items =
  match items with
  [] -> row
  | it :: rest -> fill cap (take cap row it) rest

let knapsack cap items = at (fill cap [0 | w <- [0..cap]] items) cap

let result = knapsack 5 [(2, 3); (3, 4); (4, 5); (5, 6)]
